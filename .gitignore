# Node
node_modules/

# Transient analysis / fuzzing artifacts (regenerated by the tools). The CORPORA
# are machine-local; committing them would let a stale corpus decide what a fresh
# run explores. The engine transcripts are inputs to the property-count gate.
crytic-export/
echidna-corpus/
medusa-corpus/
echidna-output.txt
medusa-output.txt
coverage-summary.txt

# Intermediate raw verifier from snarkjs; the pinned contract is src/Verifier.sol.
circuits/build/Verifier.sol

# Foundry
out/
cache/
# Raw broadcast logs (transient, one dir per deploy attempt). The authoritative
# deployment record is deployments/base-sepolia.json, committed on purpose.
broadcast/

# Secrets — laptop-only, never committed (see .env.example)
.env

# Circuit build intermediates. The FINAL artifacts are committed on purpose
# (doctrine learned from zk-escrow: artifacts never stay laptop-only) — see the
# unignore rules below. Only the reproducible intermediates are ignored:
#   - the powers-of-tau (rederivable from the documented published URL + hash)
#   - the pre-contribution zkey
circuits/build/*.ptau
circuits/build/kycpass_0000.zkey
circuits/build/kycpass.sym

# Go
cmd/kycctl/kycctl
coverage.out

# Issuer tree state (operational, laptop-only). The authoritative root lives in
# deployments/base-sepolia.json; the leaf list here is regenerable.
kycctl-state/

# Session tag (convention v1). Local to the working copy, never committed.
.session-tag
